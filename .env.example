# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
#
# The development values below are safe only on a developer machine.
# For a real installation generate secrets, e.g.: openssl rand -base64 32

# ── Docker Compose stack (make dev) ────────────────────────────────────────
POSTGRES_PASSWORD=qadam-dev-owner
APP_DB_PASSWORD=qadam-dev-app
S3_ACCESS_KEY=qadam
S3_SECRET_KEY=qadam-dev-secret
PUBLIC_URL=http://localhost:3000
DEFAULT_LOCALE=kk
LOG_LEVEL=info

# Host ports (defaults avoid clashes with a locally installed PostgreSQL/Redis/MinIO).
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=54329
VALKEY_PORT=63799
MINIO_PORT=9900
MINIO_CONSOLE_PORT=9901
GOTENBERG_PORT=3300
CLAMAV_PORT=33100
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Backend processes run natively (make run-api / run-worker / migrate) ───
# Only QADAM_* variables are read by the Go binaries; unknown QADAM_* names are
# rejected at start-up.
QADAM_ENV=development
QADAM_APP_PUBLIC_URL=http://localhost:5173
QADAM_APP_DEFAULT_LOCALE=kk
QADAM_DATABASE_URL=postgres://qadam_app:qadam-dev-app@localhost:54329/qadam?sslmode=disable
QADAM_DATABASE_MIGRATE_URL=postgres://qadam:qadam-dev-owner@localhost:54329/qadam?sslmode=disable
QADAM_VALKEY_ADDR=localhost:63799
QADAM_LOG_LEVEL=debug
QADAM_LOG_FORMAT=text
