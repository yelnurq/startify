# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
#
# The development values below are safe only on a developer machine.
# For a real installation generate secrets, e.g.: openssl rand -base64 32
# (production refuses values containing "dev").

# ── Docker Compose stack (make dev) ────────────────────────────────────────
POSTGRES_PASSWORD=qadam-dev-owner
APP_DB_PASSWORD=qadam-dev-app
# Valkey keeps revoked sessions and rate-limit counters: always behind a password.
VALKEY_PASSWORD=qadam-dev-valkey
# MinIO administrator: only the minio and minio-init containers see it.
MINIO_ROOT_USER=qadam
MINIO_ROOT_PASSWORD=qadam-dev-secret
# The application's own MinIO user, limited to its bucket (created by minio-init).
S3_ACCESS_KEY=qadam-app
S3_SECRET_KEY=qadam-dev-app-secret
S3_BUCKET=qadam
# Empty: the MinIO of the stack (minio:9000). An external S3 also needs S3_USE_SSL=true.
S3_ENDPOINT=
S3_USE_SSL=false
# Master secret of sessions and sealed data (at least 32 characters).
# Production: openssl rand -base64 48 — a value containing "dev" is refused.
AUTH_SECRET_KEY=qadam-dev-auth-secret-change-me-0123456789
# University served on http://localhost:3000; others on <slug>.<TENANT_BASE_DOMAIN>:3000.
TENANT_BASE_DOMAIN=localhost
TENANT_DEFAULT=kazutb
# required | optional | off — production requires a reachable ClamAV.
FILES_SCAN=optional
PUBLIC_URL=http://localhost:3000
DEFAULT_LOCALE=kk
LOG_LEVEL=info
# Image tag and the version /api/v1/meta reports; empty: a development build.
VERSION=

# Outgoing mail. Empty SMTP_HOST: development sends every letter to Mailpit
# (docker-compose.dev.yml), the base file only logs them, production refuses
# to start. SMTP_FROM must be an address of the university's mail domain, or
# letters fail its SPF and DMARC checks.
SMTP_HOST=
SMTP_PORT=
# none | starttls | tls — empty: none for Mailpit, starttls otherwise.
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Qadam

# OpenTelemetry tracing (OTLP over HTTP), off without an endpoint.
OTEL_ENDPOINT=
OTEL_INSECURE=false
OTEL_SAMPLE_RATIO=1

# Language models (docs/ARCHITECTURE.md, "AI layer"). mock answers without any
# model; anthropic needs ANTHROPIC_API_KEY; openai needs OPENAI_BASE_URL and
# OPENAI_MODEL (OpenAI, vLLM, Ollama, LM Studio).
AI_DEFAULT=mock
# Per-feature providers with fallbacks, e.g.
# mentor=anthropic:claude-sonnet-5-5,openai;embedding=openai
AI_ROUTES=
ANTHROPIC_API_KEY=
# A model inside the university network, e.g. Ollama: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Is the server inside the university network? auto: only for localhost, a
# private IP or a Docker service name (ollama); anything else counts as
# external — personal data is masked and users are warned. true: the server
# is on-prem (data is sent as is). false: external even at a private address
# (e.g. a proxy to api.openai.com).
OPENAI_LOCAL=auto
# Knowledge-base passages less similar to the question (cosine, 0–1) are not
# given to the mentor; tune it for the embedding model (the mock has its own).
AI_EMBEDDING_MIN_SIMILARITY=0.3

# Host ports. WEB_PORT is published by the base file; the others only by
# docker-compose.dev.yml, on DEV_BIND (this machine only by default). The
# defaults avoid clashes with a locally installed PostgreSQL/Redis/MinIO.
WEB_PORT=3000
DEV_BIND=127.0.0.1
API_PORT=8080
POSTGRES_PORT=54329
VALKEY_PORT=63799
MINIO_PORT=9900
MINIO_CONSOLE_PORT=9901
GOTENBERG_PORT=3300
CLAMAV_PORT=33100
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Demo directory of KazUTB (OpenLDAP of docker-compose.dev.yml, README
# "Демо-каталог"); its administrator is cn=admin,dc=kazutb,dc=local.
LDAP_PORT=3389
LDAP_ADMIN_PASSWORD=qadam-dev-ldap-admin

# ── Backend processes run natively (make run-api / run-worker / migrate) ───
# Only QADAM_* variables are read by the Go binaries; unknown QADAM_* names are
# rejected at start-up.
QADAM_ENV=development
QADAM_APP_PUBLIC_URL=http://localhost:5173
QADAM_APP_DEFAULT_LOCALE=kk
# The web client's index.html for showcase pages served to search engines
# (empty: a minimal page; Vite serves the showcase itself in development).
QADAM_APP_SHELL_URL=
QADAM_DATABASE_URL=postgres://qadam_app:qadam-dev-app@localhost:54329/qadam?sslmode=disable
QADAM_DATABASE_MIGRATE_URL=postgres://qadam:qadam-dev-owner@localhost:54329/qadam?sslmode=disable
QADAM_VALKEY_ADDR=localhost:63799
QADAM_VALKEY_PASSWORD=qadam-dev-valkey
QADAM_LOG_LEVEL=debug
QADAM_LOG_FORMAT=text
QADAM_AUTH_SECRET_KEY=qadam-dev-auth-secret-change-me-0123456789
QADAM_TENANT_BASE_DOMAIN=localhost
QADAM_TENANT_DEFAULT=kazutb
QADAM_SMTP_HOST=localhost
QADAM_SMTP_PORT=1025
QADAM_S3_ENDPOINT=localhost:9900
QADAM_S3_ACCESS_KEY=qadam-app
QADAM_S3_SECRET_KEY=qadam-dev-app-secret
QADAM_FILES_SCAN=optional
QADAM_FILES_CLAMAV_ADDR=localhost:33100
QADAM_AI_DEFAULT=mock
QADAM_GOTENBERG_URL=http://localhost:3300
