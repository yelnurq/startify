# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env
#
# The development values below are safe only on a developer machine.
# For a real installation generate secrets, e.g.: openssl rand -base64 32

# ── Docker Compose stack (make dev) ────────────────────────────────────────
POSTGRES_PASSWORD=qadam-dev-owner
APP_DB_PASSWORD=qadam-dev-app
S3_ACCESS_KEY=qadam
S3_SECRET_KEY=qadam-dev-secret
# Master secret of sessions and sealed data (at least 32 characters).
# Production: openssl rand -base64 48 — a value containing "dev" is refused.
AUTH_SECRET_KEY=qadam-dev-auth-secret-change-me-0123456789
# University served on http://localhost:3000; others on <slug>.localhost:3000.
TENANT_DEFAULT=kazutb
# required | optional | off — production requires a reachable ClamAV.
FILES_SCAN=optional
PUBLIC_URL=http://localhost:3000
DEFAULT_LOCALE=kk
LOG_LEVEL=info

# Language models (docs/ARCHITECTURE.md, "AI layer"). mock answers without any
# model; anthropic needs ANTHROPIC_API_KEY; openai needs OPENAI_BASE_URL and
# OPENAI_MODEL (OpenAI, vLLM, Ollama, LM Studio).
AI_DEFAULT=mock
# Per-feature providers with fallbacks, e.g.
# mentor=anthropic:claude-sonnet-5-5,openai;embedding=openai
AI_ROUTES=
ANTHROPIC_API_KEY=
# A model inside the university network, e.g. Ollama: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# true: the server is on-prem — data is not masked and users see no warning.
# Set false for api.openai.com or any other external service.
OPENAI_LOCAL=true

# Host ports (defaults avoid clashes with a locally installed PostgreSQL/Redis/MinIO).
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=54329
VALKEY_PORT=63799
MINIO_PORT=9900
MINIO_CONSOLE_PORT=9901
GOTENBERG_PORT=3300
CLAMAV_PORT=33100
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Backend processes run natively (make run-api / run-worker / migrate) ───
# Only QADAM_* variables are read by the Go binaries; unknown QADAM_* names are
# rejected at start-up.
QADAM_ENV=development
QADAM_APP_PUBLIC_URL=http://localhost:5173
QADAM_APP_DEFAULT_LOCALE=kk
# The web client's index.html for showcase pages served to search engines
# (empty: a minimal page; Vite serves the showcase itself in development).
QADAM_APP_SHELL_URL=
QADAM_DATABASE_URL=postgres://qadam_app:qadam-dev-app@localhost:54329/qadam?sslmode=disable
QADAM_DATABASE_MIGRATE_URL=postgres://qadam:qadam-dev-owner@localhost:54329/qadam?sslmode=disable
QADAM_VALKEY_ADDR=localhost:63799
QADAM_LOG_LEVEL=debug
QADAM_LOG_FORMAT=text
QADAM_AUTH_SECRET_KEY=qadam-dev-auth-secret-change-me-0123456789
QADAM_TENANT_BASE_DOMAIN=localhost
QADAM_TENANT_DEFAULT=kazutb
QADAM_SMTP_HOST=localhost
QADAM_SMTP_PORT=1025
QADAM_S3_ENDPOINT=localhost:9900
QADAM_S3_ACCESS_KEY=qadam
QADAM_S3_SECRET_KEY=qadam-dev-secret
QADAM_FILES_SCAN=optional
QADAM_FILES_CLAMAV_ADDR=localhost:33100
QADAM_AI_DEFAULT=mock
QADAM_GOTENBERG_URL=http://localhost:3300
