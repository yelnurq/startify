# Demo directory of KazUTB (development only). Users match the demo people of
# the README but have their own directory passwords (README, "Демо-каталог").
# Groups are groupOfUniqueNames: the memberOf overlay of the image fills the
# memberOf attribute of their members, nested groups included (innovation is
# a member of staff).

dn: ou=Service Accounts,dc=kazutb,dc=local
objectClass: organizationalUnit
ou: Service Accounts

dn: ou=Staff,dc=kazutb,dc=local
objectClass: organizationalUnit
ou: Staff

dn: ou=Students,dc=kazutb,dc=local
objectClass: organizationalUnit
ou: Students

dn: ou=Groups,dc=kazutb,dc=local
objectClass: organizationalUnit
ou: Groups

